# Copy to .env.local and fill in. Never commit real values.
# All variables below are read only by server-side Route Handlers.
# Do not prefix them with NEXT_PUBLIC_ (that would ship them to the browser).

# Supabase project (Settings -> API). Use the anon key with the demo-only RLS
# policies from supabase/migrations. Do NOT use the service-role key for public requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LLM provider (server-side only).
#   AI_PROVIDER=groq   -> Groq free tier (console.groq.com -> API Keys). Fast; default
#                         model openai/gpt-oss-120b. Model IDs change: check the
#                         Groq console if a request returns 404.
#   AI_PROVIDER=gemini -> Gemini via its OpenAI-compatible API (needs GEMINI_API_KEY and GEMINI_MODEL).
#   AI_PROVIDER=mock   -> offline deterministic replies marked "[Mock]" (no key needed).
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=
