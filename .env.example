# Copy to .env.local and fill in. Never commit real values.
# All variables below are read only by server-side Route Handlers.
# Do not prefix them with NEXT_PUBLIC_ (that would ship them to the browser).

# Supabase project (Settings -> API). Use the anon key with the demo-only RLS
# policies from supabase/migrations. Do NOT use the service-role key for public requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LLM provider (server-side only). Confirm this key has API credits;
# Claude Code access does not imply API access for the deployed app.
ANTHROPIC_API_KEY=
